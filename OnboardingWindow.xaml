<Window x:Class="Jarvis.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="J.A.R.V.I.S Setup"
        Height="420"
        Width="620"
        WindowStartupLocation="CenterScreen"
        Background="#090D13"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Background="#101722" BorderBrush="#24C8DB" BorderThickness="1" CornerRadius="10" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Початкове налаштування J.A.R.V.I.S" Foreground="#F3F7FB" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Після intro система запам'ятає, як звертатися до користувача." Foreground="#8C98AA" FontSize="13" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,30,0,0">
                <TextBlock Text="Ваше ім'я" Foreground="#F3F7FB" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="NameInput" Height="42" Background="#0B111A" Foreground="#F3F7FB" BorderBrush="#223044" BorderThickness="1" FontSize="16" Padding="12,0" VerticalContentAlignment="Center"/>

                <TextBlock Text="Форма звертання" Foreground="#F3F7FB" FontSize="13" FontWeight="SemiBold" Margin="0,22,0,8"/>
                <ComboBox x:Name="AddressCombo" Height="42" SelectedIndex="0" Background="#0B111A" Foreground="#111827" FontSize="15">
                    <ComboBoxItem Content="сер"/>
                    <ComboBoxItem Content="міс"/>
                    <ComboBoxItem Content="пан"/>
                    <ComboBoxItem Content="пані"/>
                </ComboBox>

                <TextBlock Text="Приклад: Добрий вечір, сер Олександре. Чим можу допомогти?" Foreground="#8C98AA" FontSize="12" Margin="0,18,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Пропустити" Width="110" Height="38" Margin="0,0,10,0" Click="Skip_Click"/>
                <Button Content="Зберегти" Width="120" Height="38" Background="#24C8DB" Foreground="#081018" FontWeight="Bold" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
