<Window x:Class="Jarvis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="J.A.R.V.I.S"
        Height="839"
        Width="1320"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0B1018"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        AllowsTransparency="False">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#131C29"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1A293A"/>
        <SolidColorBrush x:Key="LineBrush" Color="#2B3B4C"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#93A6B9"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F3F6FA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#67CDE5"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#62D6A3"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#E8BC75"/>

        <LinearGradientBrush x:Key="PanelGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#172332" Offset="0"/>
            <GradientStop Color="#111A26" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelGradientBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <LinearGradientBrush x:Key="MainPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#172331" Offset="0"/>
            <GradientStop Color="#101925" Offset="0.55"/>
            <GradientStop Color="#14202D" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#192638"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#2A4054"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#192638"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#2A4054"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#24374A"/>
                                <Setter Property="BorderBrush" Value="#67CDE5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#101925"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#182432"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="#67CDE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" BasedOn="{StaticResource IconButtonStyle}" TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A8323E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#A8323E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Окрема кнопка мікрофона. Фон залишено через TemplateBinding,
             тому код може змінювати його під час прослуховування. -->
        <Style x:Key="MicButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#1A5267"/>
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="BorderBrush" Value="#67CDE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip" Value="Увімкнути мікрофон"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MicButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#236F88"/>
                                <Setter Property="BorderBrush" Value="#8CE8FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#123F50"/>
                                <Setter Property="BorderBrush" Value="#4BB7CF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Єдиний компактний scrollbar для журналу, чату та списків. -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="#38536A"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBody"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#4E7894"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#67CDE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HorizontalScrollThumbStyle"
               TargetType="Thumb"
               BasedOn="{StaticResource ScrollThumbStyle}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="36"/>
        </Style>

        <Style x:Key="InvisiblePageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="#101925"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="1">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource InvisiblePageButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource InvisiblePageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="9"/>
                    <Setter Property="Margin" Value="0,4,0,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="5"
                                        Padding="1">
                                    <Track x:Name="PART_Track"
                                           Orientation="{TemplateBinding Orientation}"
                                           IsDirectionReversed="False"
                                           Focusable="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                          Style="{StaticResource InvisiblePageButtonStyle}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource HorizontalScrollThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                                          Style="{StaticResource InvisiblePageButtonStyle}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#101925"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                            <Grid>
                                                <ContentPresenter Margin="10,0,28,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <TextBlock Text="⌄" Foreground="{StaticResource MutedBrush}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,2"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False"
                                              Margin="10,0,28,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="False" Focusable="False">
                                <Border Background="#101925" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#101925"/>
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#24374A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LogItemTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="58"/>
                </Grid.ColumnDefinitions>
                <Border Width="4" CornerRadius="2" Background="{Binding IconColor}" HorizontalAlignment="Left" Margin="0,2,0,2"/>
                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#21374A" CornerRadius="5" Padding="6,2" Margin="0,0,7,0">
                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" MaxHeight="42"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1018" Offset="0"/>
                <GradientStop Color="#0B1420" Offset="0.46"/>
                <GradientStop Color="#070A10" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="78"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="278"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="316"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource PanelStyle}" Padding="16,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="10" Background="#204A5D" BorderBrush="#67CDE5" BorderThickness="1">
                        <TextBlock Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"><Run Text="J"/><Run Language="ru-ru" Text="."/><Run Text="S"/></TextBlock>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="J.A.R.V.I.S" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="ГОЛОСОВИЙ АСИСТЕНТ" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#101925" BorderBrush="#2A4054" BorderThickness="1" CornerRadius="12" Padding="14,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource GreenBrush}" Margin="0,0,9,0"/>
                        <TextBlock x:Name="StatusText" Text="Система готова" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock x:Name="ClockText" Text="18:42" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="DateText" Text="25 травня 2026" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Content="⚙" Style="{StaticResource IconButtonStyle}" Width="46" Margin="0,0,8,0" Click="BtnSettings_Click"/>
                    <Button Content="-" Style="{StaticResource IconButtonStyle}" Click="BtnMinimize_Click"/>
                    <Button Content="□" Style="{StaticResource IconButtonStyle}" Margin="6,0,6,0" Click="BtnMaximize_Click"/>
                    <Button Content="×" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0,14,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Швидкий доступ" Style="{StaticResource SectionTitleStyle}"/>

                    <Button Style="{StaticResource MenuButtonStyle}" x:Name="BtnOpenNotepad" Click="BtnOpenNotepad_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TXT" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Відкрити блокнот" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Notepad" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource MutedBrush}" FontSize="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource MenuButtonStyle}" x:Name="BtnOpenCalc" Click="BtnOpenCalc_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CAL" Foreground="{StaticResource GreenBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Відкрити калькулятор" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Calculator" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource MutedBrush}" FontSize="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource MenuButtonStyle}" x:Name="BtnOpenBrowser" Click="BtnOpenBrowser_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="WEB" Foreground="{StaticResource AmberBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Відкрити браузер" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Браузер за замовчуванням" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource MutedBrush}" FontSize="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource MenuButtonStyle}" x:Name="BtnTestVoice" Click="BtnTestVoice_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="VOX" Foreground="#E8BC75" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Тест голосу" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Перевірити озвучення" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource MutedBrush}" FontSize="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource MenuButtonStyle}" x:Name="BtnClearLog" Click="BtnClearLog_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CLR" Foreground="#F26D7D" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Очистити журнал" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Видалити події сесії" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource MutedBrush}" FontSize="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="16,14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Моніторинг" Style="{StaticResource SectionTitleStyle}"/>
                    <UniformGrid Columns="2" Rows="2" Margin="0,0,0,8">
                        <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock x:Name="CpuText" Text="0%" Style="{StaticResource MetricValueStyle}" FontSize="18"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="RAM" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock x:Name="RamText" Text="0%" Style="{StaticResource MetricValueStyle}" FontSize="18"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="DISK" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock x:Name="DiskText" Text="0%" Style="{StaticResource MetricValueStyle}" FontSize="18"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="NET" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock x:Name="NetworkText" Text="0 KB/s" Style="{StaticResource MetricValueStyle}" FontSize="15"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Background="#101925" BorderBrush="#24374A" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BAT" Foreground="{StaticResource AmberBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="BatteryText" Grid.Column="1" Text="-" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelStyle}" Background="{StaticResource MainPanelBrush}" Margin="0,14,14,0" ClipToBounds="True">
            <Grid>
                <Border Height="2" VerticalAlignment="Top" Background="{StaticResource AccentBrush}" Opacity="0.55"/>
                <Grid x:Name="VoiceCorePanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="32,28,32,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="АСИСТЕНТ / ГОЛОСОВЕ КЕРУВАННЯ" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="220" Height="220">
                            <Ellipse Width="216" Height="216" Stroke="#2D4B61" StrokeThickness="1"/>
                            <Ellipse x:Name="OuterRing" Width="180" Height="180" Stroke="#67CDE5" StrokeThickness="2" Opacity="0.8"/>
                            <Ellipse Width="148" Height="148" Fill="#182B3B" Stroke="#365E71" StrokeThickness="1"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="CoreIcon" Text="J.A.R.V.I.S" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="VOICE ASSISTANT" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="Скажіть «Jarvis» для активації" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="26,0,26,28">
                        <TextBlock x:Name="AiStateText" Text="Готовий допомогти" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AiSubStateText" Text="Промовте команду або напишіть її нижче" Foreground="{StaticResource MutedBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,18"/>
                        <Border Background="#101925" BorderBrush="#2A4054" BorderThickness="1" CornerRadius="12" Padding="12,8" HorizontalAlignment="Center">
                            <TextBlock Text="Голосові та текстові команди" Foreground="#B6C8D5" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="TextChatPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,0">
                        <TextBlock Text="Діалог із Jarvis" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>

                    <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChatHistoryPanel" Margin="18">
                            <Border Background="#1B2A3B" CornerRadius="12" Padding="14,10" Margin="0,0,70,14" HorizontalAlignment="Left">
                                <TextBlock Text="Готовий до роботи. Напишіть команду або скористайтеся мікрофоном." Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="168"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Активність" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                    <ComboBox x:Name="LogFilterBox" Grid.Column="1" Width="116" Height="30" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="LogFilterBox_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="ALL"/>
                        <ComboBoxItem Content="SYSTEM"/>
                        <ComboBoxItem Content="VOICE"/>
                        <ComboBoxItem Content="AI"/>
                        <ComboBoxItem Content="COMMAND"/>
                        <ComboBoxItem Content="ERROR"/>
                    </ComboBox>
                </Grid>

                <ListBox x:Name="LogListBox"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemTemplate="{StaticResource LogItemTemplate}"
                         MouseDoubleClick="LogListBox_MouseDoubleClick"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                <Border Grid.Row="2" Background="#101925" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,14,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ПРОЦЕСИ · ВИКОРИСТАННЯ ПАМ’ЯТІ" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox x:Name="ProcessListBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Grid.ColumnSpan="3"
                Style="{StaticResource PanelStyle}"
                Padding="12,7"
                Margin="0,12,0,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="48"
                        Background="#101925"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid Margin="16,0">
                        <TextBlock x:Name="ChatPlaceholder"
                                   Text="Напишіть повідомлення або команду..."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <TextBox x:Name="ChatInput"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextBrush}"
                                 FontSize="16"
                                 Height="44"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 GotFocus="ChatInput_GotFocus"
                                 TextChanged="ChatInput_TextChanged"
                                 KeyDown="ChatInput_KeyDown"/>
                    </Grid>
                </Border>

                <Button x:Name="MicButton"
                        Grid.Column="2"
                        Style="{StaticResource MicButtonStyle}"
                        Click="MicButton_Click">
                    <Viewbox Width="21" Height="21">
                        <Grid Width="24" Height="24">
                            <Path Data="M 12,3 C 10.34,3 9,4.34 9,6 L 9,11 C 9,12.66 10.34,14 12,14 C 13.66,14 15,12.66 15,11 L 15,6 C 15,4.34 13.66,3 12,3 Z M 5,10 L 5,11 C 5,14.87 8.13,18 12,18 C 15.87,18 19,14.87 19,11 L 19,10 M 12,18 L 12,21 M 8,21 L 16,21"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"/>
                        </Grid>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>