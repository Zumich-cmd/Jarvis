<Window x:Class="Jarvis.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування J.A.R.V.I.S"
        Height="720"
        Width="920"
        MinHeight="640"
        MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="#070B11"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#101A28"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#0B121D"/>
        <SolidColorBrush x:Key="LineBrush" Color="#26384F"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#99A8BB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F3F7FB"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#24C8DB"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#0B111A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#0B111A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="7">
                                            <Grid>
                                                <ContentPresenter Margin="12,0,36,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <TextBlock Text="⌄" Foreground="{StaticResource MutedBrush}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,2"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False"
                                              Margin="12,0,36,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                                <Border Background="#0B111A" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="160">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#0B111A"/>
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#18283B"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#123545"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="#0B111A" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,9,0">
                                <TextBlock x:Name="Mark" Text="✓" Foreground="#071018" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#0B111A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#24C8DB">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#121D2C"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0D1521" BorderBrush="#24C8DB" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#26384F" BorderThickness="0,0,0,1" Padding="22,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Налаштування J.A.R.V.I.S" Foreground="{StaticResource TextBrush}" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="Голос, розпізнавання, API та поведінка системи" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Content="X" Width="38" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ActionButtonStyle}" Click="Close_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBarStyle}"/>
                </ScrollViewer.Resources>
                <Grid Margin="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Розпізнавання" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                                <TextBlock Text="Wake word" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="WakeWordInput" Style="{StaticResource InputStyle}" Margin="0,0,0,14"/>

                                <TextBlock Text="Провайдер розпізнавання" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="SpeechProviderBox" Style="{StaticResource ComboStyle}" Margin="0,0,0,14">
                                    <ComboBoxItem Content="GroqWhisper"/>
                                    <ComboBoxItem Content="Vosk"/>
                                </ComboBox>

                                <CheckBox x:Name="DirectVoiceCommandsCheck" Content="Приймати голосові команди без слова Jarvis" Style="{StaticResource CheckStyle}"/>

                                <TextBlock Text="Підсилення мікрофона" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="MicGainSlider" Minimum="1" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="False" ValueChanged="MicGainSlider_ValueChanged"/>
                                    <TextBlock x:Name="MicGainText" Grid.Column="1" Text="2.8x" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Голос" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                                <TextBlock Text="Провайдер голосу" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="VoiceProviderBox" Style="{StaticResource ComboStyle}" Margin="0,0,0,14">
                                    <ComboBoxItem Content="ElevenLabs"/>
                                    <ComboBoxItem Content="Piper"/>
                                    <ComboBoxItem Content="Windows"/>
                                </ComboBox>

                                <CheckBox x:Name="VoiceResponsesCheck" Content="Озвучувати відповіді" Style="{StaticResource CheckStyle}"/>

                                <TextBlock Text="ElevenLabs Voice ID" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="ElevenVoiceIdInput" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Асистент" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                                <TextBlock Text="Groq model" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="GroqModelInput" Style="{StaticResource InputStyle}" Margin="0,0,0,14"/>

                                <TextBlock Text="Мова відповідей" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="LanguageBox" Style="{StaticResource ComboStyle}" Margin="0,0,0,14">
                                    <ComboBoxItem Content="uk-UA"/>
                                    <ComboBoxItem Content="ru-RU"/>
                                    <ComboBoxItem Content="en-US"/>
                                </ComboBox>

                                <TextBlock Text="Стиль відповіді" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="ResponseStyleBox" Style="{StaticResource ComboStyle}">
                                    <ComboBoxItem Content="Short"/>
                                    <ComboBoxItem Content="Balanced"/>
                                    <ComboBoxItem Content="Detailed"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Система" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                <CheckBox x:Name="SaveHistoryCheck" Content="Зберігати історію" Style="{StaticResource CheckStyle}"/>
                                <CheckBox x:Name="NotificationsCheck" Content="Показувати сповіщення" Style="{StaticResource CheckStyle}"/>
                                <CheckBox x:Name="AutoStartCheck" Content="Запускати разом із Windows" Style="{StaticResource CheckStyle}"/>
                                <CheckBox x:Name="AnimationsCheck" Content="Анімації інтерфейсу" Style="{StaticResource CheckStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Статус сервісів" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock x:Name="ServiceStatusText" Foreground="#B7C7D9" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#26384F" BorderThickness="0,1,0,0" Padding="22,0">
                <Grid>
                    <TextBlock x:Name="SaveStatusText" Text="Зміни застосуються після збереження. Розпізнавання може потребувати перезапуску мікрофона." Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Скасувати" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="Close_Click"/>
                        <Button Content="Зберегти" Style="{StaticResource ActionButtonStyle}" Background="#24C8DB" Foreground="#071018" FontWeight="Bold" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
